# Instagram Graph API ma'lumotlari (Meta Developer'dan olasiz)
IG_USER_ID=sizning_instagram_business_id
IG_ACCESS_TOKEN=sizning_uzoq_muddatli_token

# Serveringizning ochiq (public) manzili — Render/Railway sizga beradi
# Masalan: https://vitrina-backend.onrender.com
PUBLIC_BASE_URL=https://your-app-name.onrender.com

# Server porti (Render/Railway o'zi belgilaydi, lokal test uchun 3000)
PORT=3000

# Postlarni joylashtirish uchun maxfiy kalit (API'ni himoya qilish uchun, o'zingiz o'ylab toping)
ADMIN_SECRET=orzuning_maxfiy_sozi
